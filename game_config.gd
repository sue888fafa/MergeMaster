static func get_barracks_dispatch_range(level: int) -> int:
	var clamped_level := clampi(level, 1, 4)
	return maxi(1, BARRACKS_DETECTION_RANGE - 2 + (clamped_level - 1) * BARRACKS_DISPATCH_RANGE_INCREMENT)
