const UNIT_CLASS_RACES := [
	UNIT_RACE_ALLIANCE, # 坦克
	UNIT_RACE_HORDE, # 战士
	UNIT_RACE_ALLIANCE, # 法师
	UNIT_RACE_UNDEAD, # 刺客
